--========================================================
-- CHARACTER UTILITIES
--========================================================

local function GetCharacter(player)
	return player and player.Character
end

local function GetHumanoid(character)
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(character)
	local humanoid = GetHumanoid(character)

	return humanoid ~= nil
		and humanoid.Health > 0
end

local function GetRoot(character)
	return character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
end

local function GetHead(character)
	return character:FindFirstChild("Head")
end

--========================================================
-- TEAM CHECK
--========================================================

local function IsEnemy(player, teamCheck)

	if player == LocalPlayer then
		return false
	end

	if not teamCheck then
		return true
	end

	if LocalPlayer.Team ~= nil
		and player.Team ~= nil then

		return player.Team ~= LocalPlayer.Team
	end

	return true
end

--========================================================
-- TARGET PART
--========================================================

local function GetTargetPart(character)

	local preferred = Config.Rage.TargetPart

	if CurrentTab == "Legit" then
		preferred = Config.Legit.TargetPart
	end

	local preferredPart =
		character:FindFirstChild(preferred)

	if preferredPart
		and preferredPart:IsA("BasePart") then

		return preferredPart
	end

	local head = GetHead(character)

	if head then
		return head
	end

	local root = GetRoot(character)

	if root then
		return root
	end

	for _, object in ipairs(character:GetChildren()) do

		if object:IsA("BasePart") then
			return object
		end
	end

	return nil
end

--========================================================
-- VISIBILITY CHECK
--========================================================

local function IsVisible(part, character)

	if not part then
		return false
	end

	if not Config.Rage.VisibleCheck
		and CurrentTab == "Rage" then

		return true
	end

	if not Config.Legit.VisibleCheck
		and CurrentTab == "Legit" then

		return true
	end

	local origin = Camera.CFrame.Position
	local direction = part.Position - origin

	local params = RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character
	}

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(character)
end

--========================================================
-- GET CLOSEST TARGET
--========================================================

local function GetClosestTarget()

	local mousePosition =
		UserInputService:GetMouseLocation()

	local fov
	local maxDistance
	local teamCheck

	if CurrentTab == "Rage" then

		fov = Config.Rage.FOV
		maxDistance = Config.Rage.MaxDistance
		teamCheck = Config.Rage.TeamCheck

	else

		fov = Config.Legit.FOV
		maxDistance = Config.Legit.MaxDistance
		teamCheck = Config.Legit.TeamCheck
	end

	local closestPlayer = nil
	local closestPart = nil

	local smallestScreenDistance = fov

	for _, player in ipairs(Players:GetPlayers()) do

		if IsEnemy(player, teamCheck) then

			local character =
				GetCharacter(player)

			if character and IsAlive(character) then

				local target =
					GetTargetPart(character)

				if target then

					local worldDistance =
						(
							Camera.CFrame.Position
							- target.Position
						).Magnitude

					if worldDistance <= maxDistance then

						local screenPosition,
							onScreen =
							Camera:WorldToViewportPoint(
								target.Position
							)

						if onScreen
							and screenPosition.Z > 0 then

							local screenDistance =
								(
									Vector2.new(
										screenPosition.X,
										screenPosition.Y
									)
									- mousePosition
								).Magnitude

							if screenDistance
								< smallestScreenDistance then

								if IsVisible(
									target,
									character
								) then

									smallestScreenDistance =
										screenDistance

									closestPlayer =
										player

									closestPart =
										target
								end
							end
						end
					end
				end
			end
		end
	end

	return closestPlayer, closestPart
end

--========================================================
-- AIMBOT
--========================================================

local function AimAt(part, smoothness)

	if not part then
		return
	end

	local cameraPosition =
		Camera.CFrame.Position

	local direction =
		part.Position - cameraPosition

	if direction.Magnitude <= 0 then
		return
	end

	local targetCFrame =
		CFrame.lookAt(
			cameraPosition,
			cameraPosition + direction.Unit
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			targetCFrame,
			math.clamp(smoothness, 0.001, 1)
		)
end

--========================================================
-- TRIGGERBOT
--========================================================

local TriggerCooldown = false

local function TriggerBot()

	if TriggerCooldown then
		return
	end

	local viewport =
		Camera.ViewportSize

	local center =
		Vector2.new(
			viewport.X / 2,
			viewport.Y / 2
		)

	local ray =
		Camera:ViewportPointToRay(
			center.X,
			center.Y
		)

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		LocalPlayer.Character
	}

	local result =
		workspace:Raycast(
			ray.Origin,
			ray.Direction * 1500,
			params
		)

	if not result then
		return
	end

	local character =
		result.Instance:FindFirstAncestorOfClass(
			"Model"
		)

	if not character then
		return
	end

	local player =
		Players:GetPlayerFromCharacter(
			character
		)

	if not player then
		return
	end

	if not IsEnemy(
		player,
		Config.Rage.TeamCheck
	) then
		return
	end

	if not IsAlive(character) then
		return
	end

	TriggerCooldown = true

	FireRemote:FireServer(
		result.Position,
		result.Instance
	)

	task.delay(0.08, function()
		TriggerCooldown = false
	end)
end

--========================================================
-- ESP: MOTOR6D SKELETON
--========================================================

local function GetRigConnections(character)

	local connections = {}

	for _, object in ipairs(character:GetDescendants()) do

		if object:IsA("Motor6D") then

			local part0 = object.Part0
			local part1 = object.Part1

			if part0 and part1 then

				table.insert(
					connections,
					{
						part0,
						part1
					}
				)
			end
		end
	end

	return connections
end

