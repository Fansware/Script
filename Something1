--========================================================
-- REMOVE ESP
--========================================================

local function RemoveESP(player)

	local data = ESP[player]

	if not data then
		return
	end

	if data.Box then
		data.Box:Destroy()
	end

	if data.Name then
		data.Name:Destroy()
	end

	if data.TracerPart then
		data.TracerPart:Destroy()
	end

	for _, beam in pairs(data.Beams) do
		if beam then
			beam:Destroy()
		end
	end

	ESP[player] = nil
end

--========================================================
-- SKELETON BUILD
--========================================================

local function BuildSkeleton(player, data, character)

	for _, beam in pairs(data.Beams) do
		if beam then
			beam:Destroy()
		end
	end

	table.clear(data.Beams)

	local connections = GetRigConnections(character)

	for _, connection in ipairs(connections) do

		local part0 = connection[1]
		local part1 = connection[2]

		local attachment0 =
			Instance.new("Attachment")

		attachment0.Name = "ShooterSkeletonA"
		attachment0.Parent = part0

		local attachment1 =
			Instance.new("Attachment")

		attachment1.Name = "ShooterSkeletonB"
		attachment1.Parent = part1

		local beam =
			Instance.new("Beam")

		beam.Attachment0 = attachment0
		beam.Attachment1 = attachment1
		beam.Width0 = 0.025
		beam.Width1 = 0.025
		beam.FaceCamera = true
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		beam.Parent = part0

		table.insert(data.Beams, beam)
	end
end

--========================================================
-- UPDATE ESP
--========================================================

local function UpdateESP()

	local settings = Config.Legit.ESP

	for player, data in pairs(ESP) do

		local character = GetCharacter(player)

		local valid =
			settings.Enabled
			and character
			and IsAlive(character)
			and IsEnemy(player, settings.TeamCheck)

		if not valid then

			data.Box.Visible = false
			data.Name.Enabled = false
			data.Tracer.Enabled = false

			for _, beam in pairs(data.Beams) do
				beam.Enabled = false
			end

			continue
		end

		local root = GetRoot(character)

		if not root then
			continue
		end

		local distance =
			(Camera.CFrame.Position - root.Position).Magnitude

		if distance > settings.MaxDistance then

			data.Box.Visible = false
			data.Name.Enabled = false
			data.Tracer.Enabled = false

			continue
		end

		if settings.Box then
			data.Box.Adornee = character
			data.Box.Visible = true
		else
			data.Box.Visible = false
		end

		if settings.Name or settings.Distance then
			data.Name.Adornee = GetHead(character) or root

			local text = ""

			if settings.Name then
				text = player.Name
			end

			if settings.Distance then
				if text ~= "" then
					text = text .. "\n"
				end
				text = text .. math.floor(distance) .. " studs"
			end

			data.NameLabel.Text = text
			data.Name.Enabled = true
		else
			data.Name.Enabled = false
		end

		if settings.Tracer then
			local head = GetHead(character)

			if head then
				local targetAttachment = head:FindFirstChild("ShooterTracerTarget")

				if not targetAttachment then
					targetAttachment = Instance.new("Attachment")
					targetAttachment.Name = "ShooterTracerTarget"
					targetAttachment.Parent = head
				end

				data.TracerPart.CFrame = CFrame.new(Camera.CFrame.Position)
				data.Tracer.Attachment1 = targetAttachment
				data.Tracer.Enabled = true
			end
		else
			data.Tracer.Enabled = false
		end

		if settings.Skeleton then
			if #data.Beams == 0 then
				BuildSkeleton(player, data, character)
			end

			for _, beam in pairs(data.Beams) do
				beam.Enabled = true
			end
		else
			for _, beam in pairs(data.Beams) do
				beam.Enabled = false
			end
		end
	end
end

